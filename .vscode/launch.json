{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach NestJS",
      "port": 9229,
      "address": "127.0.0.1",
      "protocol": "inspector",
      "restart": true,
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMapPathOverrides": {
        "../../../../../src/*": "${workspaceFolder}/src/*",
        "../../../../src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*",
        "../../src/*": "${workspaceFolder}/src/*",
        "../src/*": "${workspaceFolder}/src/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**/*.js",
        "!**/node_modules/**"
      ]
    }
  ]
}
