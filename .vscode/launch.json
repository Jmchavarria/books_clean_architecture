{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach NestJS",
      "port": 9229,
      "address": "localhost",
      "restart": true,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/dist/**",
        "!**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "../../../../../../src/*": "${workspaceFolder}/src/*",
        "../../../../../src/*": "${workspaceFolder}/src/*",
        "../../../../src/*": "${workspaceFolder}/src/*",
        "../../../src/*": "${workspaceFolder}/src/*",
        "../../src/*": "${workspaceFolder}/src/*",
        "../src/*": "${workspaceFolder}/src/*"
      }
    }
  ]
}